{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TeachMyPC",
  "version": "0.1.0",
  "identifier": "com.teachmypc.desktop",
  "build": {
    "frontendDist": "../dist/teachmypc/browser",
    "devUrl": "http://localhost:4201",
    "beforeDevCommand": "npm run start -- --host 127.0.0.1 --port 4201",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TeachMyPC",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
